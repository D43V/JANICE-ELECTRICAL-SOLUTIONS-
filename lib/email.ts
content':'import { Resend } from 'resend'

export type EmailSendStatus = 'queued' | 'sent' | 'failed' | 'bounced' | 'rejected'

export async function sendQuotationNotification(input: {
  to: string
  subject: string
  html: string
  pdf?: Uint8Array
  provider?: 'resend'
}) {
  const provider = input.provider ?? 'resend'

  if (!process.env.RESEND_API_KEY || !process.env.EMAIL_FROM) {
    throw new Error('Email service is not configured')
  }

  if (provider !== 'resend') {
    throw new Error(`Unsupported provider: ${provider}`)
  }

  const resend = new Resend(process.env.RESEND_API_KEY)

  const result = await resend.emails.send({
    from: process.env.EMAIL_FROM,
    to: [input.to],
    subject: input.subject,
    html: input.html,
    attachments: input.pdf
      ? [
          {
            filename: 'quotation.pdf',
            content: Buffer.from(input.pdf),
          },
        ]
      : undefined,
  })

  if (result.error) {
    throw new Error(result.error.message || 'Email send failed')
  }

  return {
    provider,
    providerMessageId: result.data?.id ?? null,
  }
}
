export type PricingType = 'fixed' | 'per_unit' | 'hourly' | 'daily' | 'tiered' | 'travel' | 'addon' | 'discount'

export type PricingLineInput = {
  quantity: number
  basePrice?: number
  pricingType?: PricingType
  pricingConfig?: Record<string, any>
}

export function calculateLineItem({ quantity, basePrice = 0, pricingType = 'fixed', pricingConfig = {} }: PricingLineInput) {
  if (!Number.isFinite(quantity) || quantity <= 0) {
    throw new Error('Invalid quantity')
  }

  const cfg = pricingConfig ?? {}
  const base = Number(basePrice) || 0

  switch (pricingType) {
    case 'fixed': {
      const price = Number(cfg.price ?? base)
      if (!Number.isFinite(price) || price < 0) throw new Error('Invalid fixed price')
      return { unitPrice: price, subtotal: price * quantity, tax: 0, total: price * quantity }
    }
    case 'per_unit': {
      const unitPrice = Number(cfg.unit_price ?? base)
      if (!Number.isFinite(unitPrice) || unitPrice < 0) throw new Error('Invalid per-unit price')
      return { unitPrice, subtotal: unitPrice * quantity, tax: 0, total: unitPrice * quantity }
    }
    case 'hourly': {
      const hourlyRate = Number(cfg.hourly_rate ?? base)
      const minimumHours = Number(cfg.minimum_hours ?? 1)
      const effectiveHours = Math.max(quantity, minimumHours)
      if (!Number.isFinite(hourlyRate) || hourlyRate < 0) throw new Error('Invalid hourly rate')
      return { unitPrice: hourlyRate, subtotal: hourlyRate * effectiveHours, tax: 0, total: hourlyRate * effectiveHours }
    }
    case 'daily': {
      const dailyRate = Number(cfg.daily_rate ?? base)
      const minimumDays = Number(cfg.minimum_days ?? 1)
      const effectiveDays = Math.max(quantity, minimumDays)
      if (!Number.isFinite(dailyRate) || dailyRate < 0) throw new Error('Invalid daily rate')
      return { unitPrice: dailyRate, subtotal: dailyRate * effectiveDays, tax: 0, total: dailyRate * effectiveDays }
    }
    case 'tiered': {
      const tiers = Array.isArray(cfg.tiers) ? cfg.tiers : []
      if (!tiers.length) throw new Error('Tiered pricing is missing configuration')
      const matchingTier = [...tiers]
        .sort((a, b) => Number(a.min || 0) - Number(b.min || 0))
        .find((tier) => quantity >= Number(tier.min || 0) && (tier.max == null || quantity <= Number(tier.max || Infinity)))
      const price = Number(matchingTier?.price ?? base)
      if (!Number.isFinite(price) || price < 0) throw new Error('Invalid tiered pricing')
      return { unitPrice: price, subtotal: price * quantity, tax: 0, total: price * quantity }
    }
    case 'travel': {
      const baseFee = Number(cfg.base_fee ?? 0)
      const perKm = Number(cfg.per_km ?? 0)
      const distance = Number(cfg.distance ?? quantity)
      const minCharge = Number(cfg.min_charge ?? 0)
      const subtotal = Math.max(minCharge, baseFee + perKm * distance)
      return { unitPrice: subtotal / Math.max(quantity, 1), subtotal, tax: 0, total: subtotal }
    }
    case 'addon': {
      const price = Number(cfg.price ?? base)
      if (!Number.isFinite(price) || price < 0) throw new Error('Invalid addon pricing')
      return { unitPrice: price, subtotal: price * quantity, tax: 0, total: price * quantity }
    }
    case 'discount': {
      const amount = Number(cfg.amount ?? 0)
      const percentage = Number(cfg.percentage ?? 0)
      const discountValue = amount > 0 ? amount : (base * percentage) / 100
      return { unitPrice: Math.max(0, base - discountValue), subtotal: Math.max(0, base - discountValue) * quantity, tax: 0, total: Math.max(0, base - discountValue) * quantity }
    }
    default:
      throw new Error(`Unsupported pricing type: ${pricingType}`)
  }
}

export function calculateQuoteTotals(items: Array<{ quantity: number; unitPrice: number; taxRate?: number }>, taxRate = 0.15) {
  if (!Array.isArray(items)) throw new Error('Items must be an array')

  const subtotal = items.reduce((sum, item) => sum + Number(item.unitPrice || 0) * Number(item.quantity || 0), 0)
  const normalizedTaxRate = Number(taxRate || 0)
  const taxAmount = subtotal * normalizedTaxRate
  const total = subtotal + taxAmount

  return { subtotal, taxAmount, total }
}

export function calculateQuote(lines: Array<{ quantity: number; unitPriceMinor: number; addonMinor?: number }>, additionalMinor = 0, discountMinor = 0, taxMinor = 0) {
  if (!Array.isArray(lines)) throw new Error('Invalid quote lines')

  let subtotal = 0
  for (const line of lines) {
    if (!Number.isInteger(line.quantity) || line.quantity <= 0) throw new Error('Invalid quantity in quote line')
    if (!Number.isInteger(line.unitPriceMinor) || line.unitPriceMinor < 0) throw new Error('Invalid unit price')
    subtotal += line.unitPriceMinor * line.quantity
    if (Number.isInteger(line.addonMinor ?? 0)) subtotal += (line.addonMinor ?? 0)
  }

  const baseTotal = subtotal + additionalMinor
  const discountedSubtotal = Math.max(0, baseTotal - discountMinor)
  const total = discountedSubtotal + taxMinor

  return {
    subtotal,
    discountMinor,
    additionalMinor,
    taxMinor,
    total,
    finalTotal: total,
  }
}
