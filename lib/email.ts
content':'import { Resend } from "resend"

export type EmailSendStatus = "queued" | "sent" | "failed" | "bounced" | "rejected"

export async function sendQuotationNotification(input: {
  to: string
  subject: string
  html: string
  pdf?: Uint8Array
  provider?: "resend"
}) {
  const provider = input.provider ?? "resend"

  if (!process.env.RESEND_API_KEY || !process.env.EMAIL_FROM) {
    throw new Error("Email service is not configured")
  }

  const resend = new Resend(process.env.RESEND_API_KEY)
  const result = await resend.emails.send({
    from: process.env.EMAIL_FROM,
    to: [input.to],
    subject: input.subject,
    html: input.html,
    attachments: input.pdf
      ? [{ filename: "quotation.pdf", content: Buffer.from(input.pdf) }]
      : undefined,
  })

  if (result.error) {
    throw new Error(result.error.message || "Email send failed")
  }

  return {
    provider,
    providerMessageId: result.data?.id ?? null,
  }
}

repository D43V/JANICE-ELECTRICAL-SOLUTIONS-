export type PricingLine = {
  quantity: number
  unitPriceMinor: number
  addonMinor?: number
}

export function calculateQuote(lines: PricingLine[], additionalMinor = 0, discountMinor = 0, taxMinor = 0) {
  if (!Array.isArray(lines)) throw new Error('Invalid quote lines')

  let subtotal = 0
  for (const line of lines) {
    if (!Number.isInteger(line.quantity) || line.quantity <= 0) throw new Error('Invalid quantity in quote line')
    if (!Number.isInteger(line.unitPriceMinor) || line.unitPriceMinor < 0) throw new Error('Invalid unit price')
    subtotal += line.unitPriceMinor * line.quantity
    if (line.addonMinor) subtotal += line.addonMinor
  }

  const discount = Math.max(0, Number(discountMinor) || 0)
  const tax = Math.max(0, Number(taxMinor) || 0)
  const extra = Math.max(0, Number(additionalMinor) || 0)
  const total = Math.max(0, subtotal + extra - discount + tax)

  return {
    subtotal,
    discountMinor: discount,
    additionalMinor: extra,
    taxMinor: tax,
    total,
    finalTotal: total,
  }
}

export function calculateQuoteTotals(items: Array<{ quantity: number; unitPrice: number }>, taxRate = 0.15) {
  const subtotal = items.reduce((sum, item) => sum + Number(item.unitPrice || 0) * Number(item.quantity || 0), 0)
  const taxAmount = subtotal * Number(taxRate || 0)
  return { subtotal, taxAmount, total: subtotal + taxAmount }
}
