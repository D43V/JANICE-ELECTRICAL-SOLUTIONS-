import { useMemo, useState } from 'react'
import { Check, Minus, Plus } from 'lucide-react'

type Service = { id: string; name: string; price: number; description: string }

export function QuoteForm({ services }: { services: Service[] }) {
  const [selected, setSelected] = useState<string[]>([])
  const [qty, setQty] = useState<Record<string, number>>({})
  const [form, setForm] = useState({ fullName: '', email: '', phone: '', location: '', notes: '' })
  const [status, setStatus] = useState<{ kind: 'idle' | 'loading' | 'error' | 'success'; message?: string }>({ kind: 'idle' })

  const total = useMemo(
    () => services
      .filter((service) => selected.includes(service.id))
      .reduce((sum, service) => sum + service.price * (qty[service.id] ?? 1), 0),
    [services, selected, qty],
  )

  function toggle(id: string) {
    setSelected((current) => current.includes(id) ? current.filter((value) => value !== id) : [...current, id])
  }

  function changeQty(id: string, delta: number) {
    setQty((current) => ({ ...current, [id]: Math.max(1, (current[id] ?? 1) + delta) }))
  }

  async function submit(event: React.FormEvent<HTMLFormElement>) {
    event.preventDefault()
    if (!selected.length) {
      setStatus({ kind: 'error', message: 'Select at least one service.' })
      return
    }

    setStatus({ kind: 'loading', message: 'Sending your quotation request...' })

    const payload = {
      customer: {
        fullName: form.fullName,
        email: form.email,
        phone: form.phone || '',
      },
      serviceLocation: form.location,
      customerNotes: form.notes,
      items: selected.map((serviceId) => ({
        serviceId,
        quantity: qty[serviceId] ?? 1,
        options: [],
      })),
    }

    try {
      const response = await fetch('/api/quotations', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      })

      const data = await response.json()
      if (!response.ok) throw new Error(data?.error ?? 'Unable to submit quote')

      setStatus({ kind: 'success', message: `Your quotation ${data.reference ?? 'request'} was received.` })
      setSelected([])
      setQty({})
      setForm({ fullName: '', email: '', phone: '', location: '', notes: '' })
    } catch (error: any) {
      setStatus({ kind: 'error', message: error?.message ?? 'Unable to submit quote' })
    }
  }

  if (status.kind === 'success') {
    return (
      <div className="mx-auto max-w-xl rounded-lg border border-[#dedbd3] bg-white p-8 text-center">
        <div className="mx-auto flex size-14 items-center justify-center rounded-full bg-[#dfe9d9] text-[#234c1f]">
          <Check className="size-6" />
        </div>
        <h3 className="mt-5 text-2xl font-semibold text-[#101d35]">Quotation request received</h3>
        <p className="mt-3 text-[#4d4d4d]">{status.message}</p>
      </div>
    )
  }

  return (
    <form className="grid gap-10 lg:grid-cols-[1fr_360px]" onSubmit={submit}>
      <div className="flex flex-col gap-8">
        <div>
          <p className="eyebrow mb-3">01 — Services</p>
          <h2 className="text-2xl font-semibold text-[#101d35]">Select the work you need</h2>
        </div>

        <div className="grid gap-4">
          {services.map((service) => {
            const isSelected = selected.includes(service.id)
            const quantity = qty[service.id] ?? 1

            return (
              <div key={service.id} className={`rounded-2xl border p-4 ${isSelected ? 'border-[#b89953] bg-[#f8f4eb]' : 'border-[#dedbd3] bg-white'}`}>
                <div className="flex items-start justify-between gap-4">
                  <div className="space-y-2">
                    <button type="button" onClick={() => toggle(service.id)} className="flex items-center gap-3 text-left">
                      <span className={`flex size-5 items-center justify-center rounded-full border ${isSelected ? 'border-[#a07a28] bg-[#a07a28] text-white' : 'border-[#8e8e8e]'}`}>
                        {isSelected ? <Check className="size-3" /> : null}
                      </span>
                      <span className="font-semibold text-[#101d35]">{service.name}</span>
                    </button>
                    <p className="text-sm text-[#4d4d4d]">{service.description}</p>
                  </div>
                  <div className="text-right">
                    <p className="text-base font-semibold text-[#101d35]">ZMW {service.price.toFixed(2)}</p>
                  </div>
                </div>

                {isSelected ? (
                  <div className="mt-4 flex items-center justify-between rounded-xl bg-white p-3">
                    <div className="flex items-center gap-2">
                      <button type="button" onClick={() => changeQty(service.id, -1)} className="rounded-full border border-[#d7d2ca] p-2"><Minus className="size-4" /></button>
                      <span className="w-8 text-center text-sm font-semibold">{quantity}</span>
                      <button type="button" onClick={() => changeQty(service.id, 1)} className="rounded-full border border-[#d7d2ca] p-2"><Plus className="size-4" /></button>
                    </div>
                    <p className="text-sm font-medium text-[#101d35]">Line total: ZMW {(service.price * quantity).toFixed(2)}</p>
                  </div>
                ) : null}
              </div>
            )
          })}
        </div>
      </div>

      <aside className="rounded-3xl border border-[#dedbd3] bg-[#101d35] p-6 text-white">
        <p className="text-sm uppercase tracking-[0.2em] text-[#dab86b]">Quote summary</p>
        <div className="mt-6 space-y-4">
          <div className="flex items-center justify-between text-sm text-[#d9d8d4]">
            <span>Selected</span>
            <span>{selected.length} service(s)</span>
          </div>
          <div className="flex items-center justify-between text-sm text-[#d9d8d4]">
            <span>Estimated total</span>
            <span className="text-xl font-semibold text-white">ZMW {total.toFixed(2)}</span>
          </div>
        </div>

        <div className="mt-8 space-y-4">
          <input value={form.fullName} onChange={(event) => setForm((current) => ({ ...current, fullName: event.target.value }))} placeholder="Full name" className="w-full rounded-xl border border-[#2a3d5d] bg-[#1a2746] px-3 py-3 text-sm outline-none" />
          <input type="email" value={form.email} onChange={(event) => setForm((current) => ({ ...current, email: event.target.value }))} placeholder="Email" className="w-full rounded-xl border border-[#2a3d5d] bg-[#1a2746] px-3 py-3 text-sm outline-none" />
          <input value={form.phone} onChange={(event) => setForm((current) => ({ ...current, phone: event.target.value }))} placeholder="Phone" className="w-full rounded-xl border border-[#2a3d5d] bg-[#1a2746] px-3 py-3 text-sm outline-none" />
          <input value={form.location} onChange={(event) => setForm((current) => ({ ...current, location: event.target.value }))} placeholder="Site or service location" className="w-full rounded-xl border border-[#2a3d5d] bg-[#1a2746] px-3 py-3 text-sm outline-none" />
          <textarea value={form.notes} onChange={(event) => setForm((current) => ({ ...current, notes: event.target.value }))} rows={4} placeholder="Project notes" className="w-full rounded-xl border border-[#2a3d5d] bg-[#1a2746] px-3 py-3 text-sm outline-none" />
        </div>

        <button type="submit" disabled={status.kind === 'loading'} className="mt-8 w-full rounded-xl bg-[#c7a55a] px-4 py-3 font-semibold text-[#101d35] disabled:opacity-60">
          {status.kind === 'loading' ? 'Sending...' : 'Request a quotation'}
        </button>

        {status.kind === 'error' ? <p className="mt-4 text-sm text-[#f7d1d1]">{status.message}</p> : null}
      </aside>
    </form>
  )
}
