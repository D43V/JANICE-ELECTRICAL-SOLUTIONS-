import { PDFDocument, StandardFonts, rgb } from 'pdf-lib'

export type PdfQuote = {
  reference: string
  version: number
  customer: string
  email: string
  items: Array<{ description: string; quantity: number; unitPrice: number; lineTotal: number }>
  subtotal: number
  total: number
  validUntil?: string
  companyName?: string
  companyPhone?: string
  companyEmail?: string
}

export async function createQuotationPdf(quote: PdfQuote) {
  const doc = await PDFDocument.create()
  const page = doc.addPage([595, 842])
  const font = await doc.embedFont(StandardFonts.Helvetica)
  const bold = await doc.embedFont(StandardFonts.HelveticaBold)

  const margin = 48
  let y = 780

  page.drawText(quote.companyName ?? 'JANICE ELECTRICAL SOLUTIONS', {
    x: margin,
    y,
    size: 18,
    font: bold,
    color: rgb(0.08, 0.12, 0.2),
  })

  y -= 20
  page.drawText(`Quotation: ${quote.reference}`, {
    x: margin,
    y,
    size: 12,
    font: font,
    color: rgb(0.22, 0.22, 0.22),
  })

  y -= 18
  page.drawText(`Customer: ${quote.customer}`, { x: margin, y, size: 11, font: font, color: rgb(0.2, 0.2, 0.2) })
  y -= 14
  page.drawText(`Email: ${quote.email}`, { x: margin, y, size: 11, font: font, color: rgb(0.2, 0.2, 0.2) })

  y -= 28
  page.drawText('Description', { x: margin, y, size: 10, font: bold })
  page.drawText('Qty', { x: 300, y, size: 10, font: bold })
  page.drawText('Unit price', { x: 380, y, size: 10, font: bold })
  page.drawText('Line total', { x: 500, y, size: 10, font: bold })

  y -= 14
  for (const item of quote.items) {
    if (y < 120) break
    page.drawText(item.description.length > 38 ? `${item.description.slice(0, 35)}...` : item.description, { x: margin, y, size: 9, font: font, color: rgb(0.2, 0.2, 0.2) })
    page.drawText(String(item.quantity), { x: 300, y, size: 9, font: font, color: rgb(0.2, 0.2, 0.2) })
    page.drawText(formatCurrency(item.unitPrice), { x: 380, y, size: 9, font: font, color: rgb(0.2, 0.2, 0.2) })
    page.drawText(formatCurrency(item.lineTotal), { x: 500, y, size: 9, font: font, color: rgb(0.2, 0.2, 0.2) })
    y -= 18
  }

  y -= 22
  page.drawText(`Subtotal: ${formatCurrency(quote.subtotal)}`, { x: 400, y, size: 11, font: bold, color: rgb(0.2, 0.2, 0.2) })
  y -= 18
  page.drawText(`Total: ${formatCurrency(quote.total)}`, { x: 400, y, size: 14, font: bold, color: rgb(0.08, 0.12, 0.2) })

  return Buffer.from(await doc.save())
}

function formatCurrency(value: number) {
  return new Intl.NumberFormat('en-ZA', {
    style: 'currency',
    currency: 'ZAR',
    minimumFractionDigits: 2,
  }).format(Number(value || 0))
}

export function getQuotationPdfFilename(reference: string) {
  return `${reference.replace(/\s+/g, '-').toLowerCase()}.pdf`
}
