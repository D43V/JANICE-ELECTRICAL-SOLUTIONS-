import Link from 'next/link'
import { redirect } from 'next/navigation'
import { createClient } from '@/lib/supabase/server'

export default async function Admin() {
  const supabase = await createClient()
  const { data: { user } } = await supabase.auth.getUser()
  if (!user) redirect('/admin/login')

  const { data: profile } = await supabase.from('profiles').select('role').eq('id', user.id).maybeSingle()
  if (profile?.role !== 'admin') {
    return (
      <main className="min-h-screen bg-[#101D35] px-5 py-20 text-white">
        <div className="mx-auto max-w-md text-center">
          <p className="text-sm tracking-[.28em] text-[#d9ba68]">Access denied</p>
          <p className="mt-4 text-lg">Only administrators can access this area.</p>
        </div>
      </main>
    )
  }

  const [{ count: total }, { count: underReview }, { count: accepted }, { data: recent }] = await Promise.all([
    supabase.from('quotations').select('id', { count: 'exact', head: true }),
    supabase.from('quotations').select('id', { count: 'exact', head: true }).eq('status', 'under_review'),
    supabase.from('quotations').select('id', { count: 'exact', head: true }).eq('status', 'accepted'),
    supabase.from('quotations').select('reference,status,total_amount,submitted_at').order('submitted_at', { ascending: false }).limit(5),
  ])

  return (
    <main className="min-h-screen bg-[#F3F5F8] px-5 py-8 text-[#101D35]">
      <div className="mx-auto max-w-6xl">
        <div className="mb-8 flex items-center justify-between gap-3">
          <div>
            <p className="text-xs font-semibold uppercase tracking-[.28em] text-[#8d6d2d]">Admin</p>
            <h1 className="mt-2 text-3xl font-bold">Dashboard</h1>
          </div>
          <div className="flex gap-3">
            <Link href="/admin/quotations" className="rounded-xl bg-[#101d35] px-4 py-3 text-sm font-semibold text-white">Quotations</Link>
            <Link href="/admin/services" className="rounded-xl border border-[#d9d4ca] bg-white px-4 py-3 text-sm font-semibold text-[#101d35]">Services</Link>
            <Link href="/admin/settings" className="rounded-xl border border-[#d9d4ca] bg-white px-4 py-3 text-sm font-semibold text-[#101d35]">Settings</Link>
          </div>
        </div>

        <div className="grid gap-4 md:grid-cols-3">
          <Metric label="Total quotes" value={Number(total ?? 0)} />
          <Metric label="Under review" value={Number(underReview ?? 0)} />
          <Metric label="Accepted" value={Number(accepted ?? 0)} />
        </div>

        <div className="mt-8 grid gap-6 lg:grid-cols-[1.1fr_0.9fr]">
          <section className="rounded-3xl border border-[#d9d4ca] bg-white p-6 shadow-sm">
            <div className="mb-4 flex items-center justify-between">
              <h2 className="text-xl font-semibold">Recent quotes</h2>
              <Link href="/admin/quotations" className="text-sm font-semibold text-[#8d6d2d]">View all</Link>
            </div>

            <div className="space-y-4">
              {(recent ?? []).map((quote) => (
                <div key={quote.reference} className="flex items-center justify-between rounded-2xl border border-[#efe8df] p-4">
                  <div>
                    <p className="font-semibold text-[#101d35]">{quote.reference}</p>
                    <p className="text-sm text-[#5b5a57]">{quote.submitted_at ? new Date(quote.submitted_at).toLocaleDateString() : '—'}</p>
                  </div>
                  <div className="text-right">
                    <p className="font-semibold text-[#101d35]">ZMW {Number(quote.total_amount || 0).toFixed(2)}</p>
                    <p className="text-xs uppercase tracking-[.2em] text-[#8d6d2d]">{quote.status}</p>
                  </div>
                </div>
              ))}
            </div>
          </section>

          <section className="rounded-3xl border border-[#d9d4ca] bg-white p-6 shadow-sm">
            <h2 className="text-xl font-semibold">Quick actions</h2>
            <div className="mt-5 space-y-3">
              <Link href="/admin/quotations" className="block rounded-xl bg-[#f5f3ee] px-4 py-3 text-sm font-semibold text-[#101d35]">Manage quotations</Link>
              <Link href="/admin/services" className="block rounded-xl bg-[#f5f3ee] px-4 py-3 text-sm font-semibold text-[#101d35]">Manage services</Link>
              <Link href="/admin/settings" className="block rounded-xl bg-[#f5f3ee] px-4 py-3 text-sm font-semibold text-[#101d35]">Business settings</Link>
            </div>
          </section>
        </div>
      </div>
    </main>
  )
}

function Metric({ label, value }: { label: string; value: number }) {
  return (
    <div className="rounded-2xl border border-[#dfdbd1] bg-white p-5 shadow-sm">
      <p className="text-sm text-black/55">{label}</p>
      <p className="mt-3 text-3xl font-bold text-[#101d35]">{value}</p>
    </div>
  )
}
