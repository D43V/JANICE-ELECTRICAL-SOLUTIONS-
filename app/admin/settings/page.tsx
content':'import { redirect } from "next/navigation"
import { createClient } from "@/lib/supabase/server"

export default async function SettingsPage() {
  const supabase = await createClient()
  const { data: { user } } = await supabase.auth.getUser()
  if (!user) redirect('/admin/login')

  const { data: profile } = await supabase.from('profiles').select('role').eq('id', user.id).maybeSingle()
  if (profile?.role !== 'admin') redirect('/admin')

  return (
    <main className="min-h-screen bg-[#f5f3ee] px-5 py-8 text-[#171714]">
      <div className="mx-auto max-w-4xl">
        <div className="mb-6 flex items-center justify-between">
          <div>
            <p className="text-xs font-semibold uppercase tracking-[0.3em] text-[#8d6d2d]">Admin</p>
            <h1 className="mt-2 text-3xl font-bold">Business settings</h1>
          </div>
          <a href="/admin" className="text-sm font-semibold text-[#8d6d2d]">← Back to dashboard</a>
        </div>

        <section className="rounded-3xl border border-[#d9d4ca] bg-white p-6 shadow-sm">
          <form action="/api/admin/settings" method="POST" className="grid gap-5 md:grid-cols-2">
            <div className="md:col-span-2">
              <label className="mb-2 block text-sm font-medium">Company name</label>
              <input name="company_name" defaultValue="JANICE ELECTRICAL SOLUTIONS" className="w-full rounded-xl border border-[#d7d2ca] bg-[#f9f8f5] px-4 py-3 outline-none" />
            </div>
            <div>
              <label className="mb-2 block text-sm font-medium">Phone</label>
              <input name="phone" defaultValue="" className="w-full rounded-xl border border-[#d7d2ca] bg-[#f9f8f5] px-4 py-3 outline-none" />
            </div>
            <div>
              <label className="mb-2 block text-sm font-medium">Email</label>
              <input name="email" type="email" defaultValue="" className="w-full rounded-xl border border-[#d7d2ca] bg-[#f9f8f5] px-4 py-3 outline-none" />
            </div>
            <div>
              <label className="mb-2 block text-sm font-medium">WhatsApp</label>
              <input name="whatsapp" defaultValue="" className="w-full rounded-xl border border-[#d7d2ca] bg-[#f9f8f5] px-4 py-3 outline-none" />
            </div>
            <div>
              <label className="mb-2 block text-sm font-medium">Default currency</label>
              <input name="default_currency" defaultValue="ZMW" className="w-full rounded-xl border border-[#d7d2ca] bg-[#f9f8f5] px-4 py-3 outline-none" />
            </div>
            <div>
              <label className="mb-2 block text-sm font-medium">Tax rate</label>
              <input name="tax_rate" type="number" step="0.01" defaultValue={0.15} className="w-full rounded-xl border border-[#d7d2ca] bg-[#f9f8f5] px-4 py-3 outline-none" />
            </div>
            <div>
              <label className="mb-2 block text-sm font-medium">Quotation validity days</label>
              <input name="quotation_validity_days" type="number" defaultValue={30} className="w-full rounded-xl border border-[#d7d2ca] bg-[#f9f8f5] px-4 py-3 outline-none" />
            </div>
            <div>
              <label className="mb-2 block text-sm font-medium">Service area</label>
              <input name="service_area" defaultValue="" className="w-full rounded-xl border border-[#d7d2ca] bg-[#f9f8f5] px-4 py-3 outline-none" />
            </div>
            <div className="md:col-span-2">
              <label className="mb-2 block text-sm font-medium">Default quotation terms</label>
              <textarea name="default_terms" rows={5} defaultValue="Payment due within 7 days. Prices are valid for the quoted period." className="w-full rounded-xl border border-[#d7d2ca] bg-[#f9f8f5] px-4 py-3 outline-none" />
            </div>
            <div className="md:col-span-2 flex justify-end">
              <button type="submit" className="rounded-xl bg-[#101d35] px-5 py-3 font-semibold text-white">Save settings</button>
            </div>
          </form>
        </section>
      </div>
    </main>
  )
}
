import Link from 'next/link'
import { redirect } from 'next/navigation'
import { createClient } from '@/lib/supabase/server'
import { QuotationEditor } from '@/components/quotation-editor'

export default async function QuotationDetailPage({ params }: { params: Promise<{ id: string }> }) {
  const { id } = await params
  const supabase = await createClient()
  const { data: { user } } = await supabase.auth.getUser()
  if (!user) redirect('/admin/login')

  const { data: profile } = await supabase.from('profiles').select('role').eq('id', user.id).maybeSingle()
  if (profile?.role !== 'admin') redirect('/admin')

  const { data: quote } = await supabase
    .from('quotations')
    .select('id,reference,status,subtotal,additional_charges,discount_amount,tax_amount,total_amount,admin_notes,submitted_at,customers(full_name,email,phone)')
    .eq('id', id)
    .single()

  const { data: items } = await supabase.from('quotation_items').select('*').eq('quotation_id', id)

  if (!quote) return <div>Quote not found</div>

  const customer = Array.isArray(quote.customers) ? quote.customers[0] : quote.customers

  return (
    <main className="min-h-screen bg-[#f5f3ee] px-5 py-8 text-[#171714]">
      <div className="mx-auto max-w-5xl">
        <div className="mb-6 flex items-center justify-between">
          <div>
            <p className="text-xs font-semibold uppercase tracking-[0.3em] text-[#8d6d2d]">Admin</p>
            <h1 className="mt-2 text-3xl font-bold">Quote {quote.reference}</h1>
          </div>
          <Link href="/admin/quotations" className="text-sm font-semibold text-[#8d6d2d]">← Back to quotations</Link>
        </div>

        <div className="grid gap-6 lg:grid-cols-[1.4fr_0.6fr]">
          <section className="rounded-3xl border border-[#d9d4ca] bg-white p-6 shadow-sm">
            <h2 className="text-xl font-semibold">Customer</h2>
            <div className="mt-4 space-y-2 text-sm">
              <p><strong>Name:</strong> {customer?.full_name ?? '—'}</p>
              <p><strong>Email:</strong> {customer?.email ?? '—'}</p>
              <p><strong>Phone:</strong> {customer?.phone ?? '—'}</p>
              <p><strong>Notes:</strong> {quote.admin_notes ?? 'None'}</p>
            </div>

            <div className="mt-8">
              <h3 className="text-lg font-semibold">Items</h3>
              <div className="mt-4 space-y-3">
                {(items ?? []).map((item) => (
                  <div key={item.id} className="rounded-2xl border border-[#efe8df] p-4">
                    <div className="flex items-center justify-between gap-4">
                      <div>
                        <p className="font-semibold">{item.description_snapshot}</p>
                        <p className="text-sm text-[#5b5a57]">Qty: {item.quantity}</p>
                      </div>
                      <div className="text-right text-sm">
                        <p>Unit: ZMW {Number(item.unit_price ?? item.unit_price_snapshot ?? 0).toFixed(2)}</p>
                        <p>Total: ZMW {Number(item.line_total ?? 0).toFixed(2)}</p>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </section>

          <div className="space-y-6">
            <div className="rounded-3xl border border-[#d9d4ca] bg-white p-6 shadow-sm">
              <h3 className="text-lg font-semibold">Totals</h3>
              <div className="mt-4 space-y-3 text-sm">
                <div className="flex justify-between"><span>Subtotal</span><strong>ZMW {Number(quote.subtotal || 0).toFixed(2)}</strong></div>
                <div className="flex justify-between"><span>Tax</span><strong>ZMW {Number(quote.tax_amount || 0).toFixed(2)}</strong></div>
                <div className="flex justify-between text-base"><span>Total</span><strong>ZMW {Number(quote.total_amount || 0).toFixed(2)}</strong></div>
              </div>
            </div>

            <QuotationEditor quote={quote} />
          </div>
        </div>
      </div>
    </main>
  )
}
